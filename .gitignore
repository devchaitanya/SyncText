# Build artifacts
build/*.o
build/editor
build/*.d

# User document files (generated in user_docs/, incl. per --doc subdirectories)
user_docs/*_doc.txt
user_docs/*/

# Editor-window tty markers
log_files/.*_edit_tty

# Log files (generated in log_files/)
log_files/*.log

# Test data files (in data/ from old tests)
data/*.txt
data/*.log

# Backup files
*.txt_doc.txt
*.bak
*~

# IDE files
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Message queues and shared memory (runtime artifacts)
/dev/mqueue/synctext_*
/dev/shm/synctext_*

# CRDT unit-test build output
tests/crdt/build/

# Per-run stderr logs written by the test suite
log_files/*.err

# Python bytecode
__pycache__/
